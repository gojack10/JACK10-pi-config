#!/usr/bin/env node
(async () => {
  const { realpathSync } = await import('node:fs');
  const { pathToFileURL } = await import('node:url');
  const cli = new URL('../extensions/bf2-swarm/controller.mjs', pathToFileURL(realpathSync(process.argv[1])));
  const { main } = await import(cli);
  await main();
})().catch(error => { console.error(`bf2-swarm: ${error.message}`); process.exitCode = 1; });
